{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx nx:*)",
      "Bash(npm start)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run i18n:check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Bash(npm publish:*)"]
  },
  "enabledMcpjsonServers": ["angular-cli", "nx-mcp"]
}
