{
  "name": "@portfolio/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve portfolio",
    "prepare": "husky && git config commit.template .gitmessage || true",
    "build": "nx build portfolio",
    "test": "nx run-many -t test && node --test \"tools/scripts/*.spec.mjs\"",
    "lint": "nx run-many -t lint",
    "i18n:check": "node tools/scripts/check-i18n.mjs",
    "snippets:extract": "node tools/scripts/extract-snippets.mjs",
    "license:write": "node tools/scripts/write-license.mjs",
    "test:coverage": "nx run-many -t test --coverage --skip-nx-cache",
    "quality:report": "npm run test:coverage && node tools/scripts/build-quality-report.mjs",
    "build:pages": "nx build portfolio --base-href=/portfolio/",
    "site:stage": "node tools/scripts/stage-site.mjs",
    "e2e": "npm run build:pages && npm run site:stage && playwright test -c e2e",
    "e2e:only": "playwright test -c e2e",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~22.1.0",
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@primeuix/themes": "^3.0.1",
    "primeng": "^22.1.2",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.0",
    "@analogjs/vitest-angular": "~2.6.0",
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.8.0",
    "@lhci/cli": "^0.15.1",
    "@nx/angular": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.64.0",
    "@schematics/angular": "~22.1.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "angular-eslint": "^22.1.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "msw": "^2.15.0",
    "nx": "23.3.0",
    "prettier": "~3.9.10",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  },
  "msw": {
    "workerDirectory": [
      "apps/portfolio/public"
    ]
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
